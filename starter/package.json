{
  "name": "webapp-starter",
  "version": "1.0.0",
  "description": "Starter for Webapplikasjoner 2026 (RedwoodSDK, React 19, Vite 8, Drizzle/D1, Tailwind 4, Vitest, Playwright)",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "release": "npm run clean && npm run build && wrangler deploy",
    "clean": "rm -rf ./node_modules/.vite",
    "generate": "wrangler types",
    "lint": "tsc --noEmit",
    "worker:run": "rwsdk worker-run",
    "migrate:new": "drizzle-kit generate",
    "migrate:dev": "wrangler d1 migrations apply DB --local",
    "migrate:prod": "wrangler d1 migrations apply DB --remote",
    "seed": "rwsdk worker-run ./src/db/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug"
  },
  "dependencies": {
    "@dnd-kit/helpers": "0.5.0",
    "@dnd-kit/react": "0.5.0",
    "@tailwindcss/vite": "4.3.3",
    "better-auth": "1.7.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "17.4.2",
    "drizzle-orm": "1.0.0-rc.4",
    "lucide-react": "1.42.0",
    "nanoid": "5.1.16",
    "ohash": "2.0.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "rwsdk": "1.7.3",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "ufo": "1.6.4",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.4",
    "@cloudflare/workers-types": "5.20260907.1",
    "@playwright/test": "1.63.0",
    "@rolldown/plugin-babel": "0.2.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "babel-plugin-react-compiler": "1.0.0",
    "better-sqlite3": "12.11.1",
    "drizzle-kit": "1.0.0-rc.4",
    "happy-dom": "20.14.0",
    "tsx": "4.23.13",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.129.0"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true,
    "workerd": true,
    "fsevents": true
  }
}
